rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && request.auth.token.email == 'malekhassan384@gmail.com';
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'inboxesCount', 'registeredCounted', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.email is string && data.email.size() > 3 && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512))
        && (!('role' in data) || (data.role in ['owner', 'user']))
        && (!('registeredCounted' in data) || (data.registeredCounted is bool))
        && (!('inboxesCount' in data) || (data.inboxesCount is number && data.inboxesCount >= 0));
    }

    function isValidUserInbox(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'address', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'address', 'duration', 'createdAt', 'expiresAt', 'status'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.userId == userId
        && data.address is string && data.address.size() > 3 && data.address.size() <= 256
        && (!('duration' in data) || (data.duration is string && data.duration.size() <= 32))
        && (!('status' in data) || (data.status in ['active', 'expired']));
    }

    function isValidSiteStats(data) {
      return data.keys().hasAll(['visitorsCount', 'inboxesGeneratedCount'])
        && data.keys().hasOnly(['visitorsCount', 'inboxesGeneratedCount', 'signedInUsersCount', 'updatedAt'])
        && data.visitorsCount is number && data.visitorsCount >= 0
        && data.inboxesGeneratedCount is number && data.inboxesGeneratedCount >= 0
        && (!('signedInUsersCount' in data) || (data.signedInUsersCount is number && data.signedInUsersCount >= 0));
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isSelf(userId) || isOwner());
      allow list: if isOwner();
      allow create: if isValidId(userId) && isSelf(userId) && isValidUserProfile(incoming())
        && (incoming().role != 'owner' || isOwner());
      allow update: if isValidId(userId) && (isSelf(userId) || isOwner())
        && isValidUserProfile(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'inboxesCount', 'registeredCounted', 'updatedAt', 'role'])
        && (incoming().role == existing().role || isOwner());
      allow delete: if isValidId(userId) && (isSelf(userId) || isOwner());

      // Inboxes Subcollection
      match /inboxes/{inboxId} {
        allow get: if isValidId(userId) && isValidId(inboxId) && (isSelf(userId) || isOwner());
        allow list: if isValidId(userId) && (isSelf(userId) || isOwner());
        allow create: if isValidId(userId) && isValidId(inboxId) && isSelf(userId)
          && isValidUserInbox(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(inboxId) && (isSelf(userId) || isOwner())
          && isValidUserInbox(incoming(), userId)
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'expiresAt', 'duration']);
        allow delete: if isValidId(userId) && isValidId(inboxId) && (isSelf(userId) || isOwner());
      }
    }

    // Site Stats
    match /stats/site {
      allow get: if true;
      allow create, update: if isValidSiteStats(incoming());
      allow delete: if isOwner();
    }
  }
}
